# Copie para secret.yaml e preencha os valores em base64.
# Gerar base64: echo -n "valor" | base64
#
# kubectl create secret generic sitema-bfx-secret -n sitema-bfx \
#   --from-literal=DATABASE_URL='postgresql://...' \
#   --from-literal=SESSION_SECRET='...' \
#   --dry-run=client -o yaml > secret.yaml
#
# Ou use o template abaixo (substitua os valores base64).
apiVersion: v1
kind: Secret
metadata:
  name: sitema-bfx-secret
  namespace: sitema-bfx
type: Opaque
stringData:
  # Use stringData para texto legível (Kubernetes codifica em base64)
  # Não commitar secret.yaml com valores reais; use apenas em CI ou local.
  DATABASE_URL: "postgresql://user:pass@host:5432/bfx?schema=public"
  SESSION_SECRET: "sua-chave-secreta-min-32-chars"
  # NEXT_PUBLIC_APP_URL: "https://sitema-bfx.seudominio.com"
  # CRON_SECRET: "..."
  # ASAAS_API_KEY: "..."
  # ASAAS_ENV: "sandbox"
  # OPENAI_API_KEY: "..."
  # GOOGLE_GENERATIVE_AI_API_KEY: "..."
