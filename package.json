{
  "name": "sistema-bfx",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/copiar-ort.mjs",
    "ort:copiar": "node scripts/copiar-ort.mjs",
    "dev": "cross-env NEXT_DISABLE_TURBOPACK=1 next dev -H 0.0.0.0 -p 3008",
    "prebuild": "npx prisma generate && node scripts/copiar-ort.mjs",
    "build": "cross-env NODE_ENV=production NEXT_DISABLE_TURBOPACK=1 next build && node scripts/stamp-sw.mjs",
    "start": "next start",
    "lint": "eslint",
    "cores:scan": "node scripts/design-tokens/raw-color-scan.mjs src",
    "cores:check": "node scripts/design-tokens/raw-color-scan.mjs src --check",
    "contraste:check": "node scripts/design-tokens/token-contrast.mjs",
    "escala:scan": "node scripts/design-tokens/escala-scan.mjs src",
    "escala:check": "node scripts/design-tokens/escala-scan.mjs src --check",
    "escala:baseline": "node scripts/design-tokens/escala-scan.mjs src --baseline",
    "jsx:check": "node scripts/design-tokens/jsx-sanidade.mjs src",
    "ui:runtime": "node scripts/ui-runtime/rendered-ui-audit.mjs",
    "ui:runtime:strict": "node scripts/ui-runtime/rendered-ui-audit.mjs --require-browser",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "db:start": "docker compose up -d db",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "prisma:generate": "npx prisma generate",
    "docker:up": "docker compose up -d minio db && sleep 3 && npm run db:migrate && docker compose up -d app",
    "db:minio": "docker compose up -d minio",
    "docker:build": "docker compose build",
    "evolution:up": "docker compose -f docker-compose.evolution.yml up -d",
    "evolution:down": "docker compose -f docker-compose.evolution.yml down"
  },
  "dependencies": {
