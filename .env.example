# Copie para .env.local e preencha os valores

# Banco de dados (obrigatório)
# Em produção (Vercel/Neon/Supabase): use connection string com pooler se disponível (reduz conexões no serverless).
DATABASE_URL="postgresql://user:password@localhost:5432/bfx"

# Sessão JWT (obrigatório em produção)
SESSION_SECRET="sua-chave-secreta-aleatoria-min-32-chars"

# Cron - protege o endpoint /api/cron/cleanup-uploads
# Em produção na Vercel: defina no painel Project > Settings > Environment Variables
# Para chamada manual: curl -H "Authorization: Bearer SEU_SECRET" https://seu-app.vercel.app/api/cron/cleanup-uploads
CRON_SECRET="seu-secret-para-cron-aleatorio"

# Asaas - geração de boleto ao fechar venda com forma de pagamento Boleto
# Chave da API (sandbox ou produção). Se não definida, a geração de boleto fica desabilitada.
# ASAAS_API_KEY="sua-chave-asaas"
# Ambiente: sandbox (default) ou production
# ASAAS_ENV="sandbox"

# URL pública do app (recomendado em produção na Vercel)
# Use a URL do deploy, ex.: https://sitema-bfx.vercel.app
# NEXT_PUBLIC_APP_URL="https://sitema-bfx.vercel.app"
