# Copie para .env ou .env.local e preencha os valores
# Next.js carrega: .env.local (prioridade), .env
# Não commitar .env / .env.local (já estão no .gitignore)

# ========== Obrigatórias ==========

# Banco de dados
# Local: postgres (Docker, etc.). Produção (Vercel): use connection string com pooler se disponível.
DATABASE_URL="postgresql://user:password@localhost:5432/bfx?schema=public"

# Sessão JWT (obrigatório em produção; mín. 32 caracteres)
SESSION_SECRET="sua-chave-secreta-aleatoria-min-32-chars"

# ========== Opcionais – app ==========

# URL pública do app (recomendado em produção; usada em links, redirects, etc.)
# NEXT_PUBLIC_APP_URL="https://sitema-bfx.vercel.app"

# Cron: protege /api/cron/cleanup-uploads (Vercel chama todo domingo 03:00 UTC)
# Defina na Vercel para o Cron autorizar. Manual: curl -H "Authorization: Bearer SEU_SECRET" https://seu-app.vercel.app/api/cron/cleanup-uploads
# CRON_SECRET="seu-secret-para-cron-aleatorio"

# MinIO: armazenamento de imagens de produtos (S3-compatible)
# Sem essas variáveis, imagens são salvas em public/uploads/produtos
# MINIO_ENDPOINT="http://localhost:9000"
# MINIO_ACCESS_KEY="minioadmin"
# MINIO_SECRET_KEY="minioadmin"
# MINIO_BUCKET="produtos"
# MINIO_PUBLIC_URL="http://localhost:9000"

# Asaas: geração de boleto (forma de pagamento Boleto). Sem isso, boleto fica desabilitado.
# ASAAS_API_KEY="sua-chave-asaas"
# ASAAS_ENV="sandbox"
# ASAAS_ENV="production"

# WhatsApp: Evolution API (envio automático de recibo, assinatura, boleto, lembretes). Alternativa: config via Configurações > WhatsApp
# EVOLUTION_API_URL="http://localhost:8080"
# EVOLUTION_API_KEY="sua-api-key-evolution"
# EVOLUTION_INSTANCE="bfx"
# WHATSAPP_AUTO_ENABLED="1"

# WhatsApp Business Cloud API (Meta) — provider oficial, sem risco de ban do número.
# Preferir config na tabela Config (Configurações > WhatsApp); estas são fallback via env.
# META_WHATSAPP_TOKEN="EAAG..."                 # System User token permanente
# META_WHATSAPP_PHONE_NUMBER_ID="123456789"     # Phone Number ID do WhatsApp Business
# META_WHATSAPP_BUSINESS_ID="123456789"         # WhatsApp Business Account ID
# META_WHATSAPP_API_VERSION="v21.0"
# META_WHATSAPP_VERIFY_TOKEN="token-de-verificacao-do-webhook"
# App Secret do app da Meta — valida X-Hub-Signature-256 no webhook.
# Sem ele o webhook rejeita TODO POST com 401.
# META_APP_SECRET=

# E-mail / SMTP (relatórios semanais/mensais, notificação de venda à empresa parceira).
# Alternativa: config via tabela Config (smtpHost, smtpUser, etc.). Sem isso, e-mails são pulados.
# SMTP_HOST="smtp.seuprovedor.com"
# SMTP_PORT="587"                                # 587 = STARTTLS | 465 = TLS
# SMTP_USER="usuario@dominio.com"
# SMTP_PASS="sua-senha-ou-app-password"
# SMTP_FROM="BFX <no-reply@dominio.com>"

# Alertas internos admin (/api/cron/alertas-admin)
# ALERTA_ASSINATURA_DIAS="3"                     # assinatura pendente há mais de N dias vira alerta
# ALERTA_ESTOQUE_MINIMO="3"                      # produto com estoque <= N vira alerta

# ========== Opcionais – AI (OpenAI / Gemini) ==========
# Necessárias apenas se o app usar rotas de chat/IA com @ai-sdk/openai ou @ai-sdk/google

# OpenAI (ou compatível, ex.: Groq)
# OPENAI_API_KEY="sk-..."

# Google Generative AI / Gemini
# GOOGLE_GENERATIVE_AI_API_KEY="..."

# LiteLLM Proxy (gateway para modelos locais ou terceiros)
# LITELLM_URL="http://localhost:4000"
# LITELLM_KEY="sk-..."
# LITELLM_MODEL="gpt-4o"
# LITELLM_ENABLE_THINKING="true"

# Uber Direct: cotação de frete (opcional)
# UBER_DIRECT_CUSTOMER_ID="seu-customer-id"
# UBER_DIRECT_TOKEN="seu-token"
# Endereço de retirada (origem) em JSON, ex:
# UBER_PICKUP_ADDRESS_JSON={"street_address":["Rua Exemplo, 123"],"city":"São Paulo","state":"SP","zip_code":"01310100","country":"BR"}

# ========== Apenas referência (não definir no .env) ==========
# NODE_ENV          — definido automaticamente (development / production)
# SKIP_ENV_VALIDATION — usado no CI (GitHub Actions) para o build passar sem validar env
# NEXT_DISABLE_TURBOPACK — usado nos scripts do package.json em dev/build
