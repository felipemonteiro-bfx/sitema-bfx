generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id             Int       @id @default(autoincrement())
  nome           String    @unique
  renda          Float?
  empresa        String?
  matricula      String?
  telefone       String?
  cpf            String?
  cnpj           String?
  tipo           String?
  dataNascimento DateTime? @map("data_nascimento")
  cep            String?
  endereco       String?
  email          String?
  asaasCustomerId String?   @map("asaas_customer_id")
  atendimentoHumanoAt DateTime? @map("atendimento_humano_at")
  empresaParceiraId Int?    @map("empresa_parceira_id")
  empresaParceira   EmpresaParceira? @relation(fields: [empresaParceiraId], references: [id])
  vendas         Venda[]
  // CRM: estágio no funil e origem do relacionamento. Um "lead" é um Cliente que
  // ainda não comprou (importado da lista de funcionários da empresa parceira);
  // ao registrar a 1ª venda, o estágio vira "cliente" automaticamente.
  estagioCrm     String?  @default("cliente") @map("estagio_crm") // novo_lead | contatado | negociando | cliente | inativo
  origem         String?  @map("origem")                          // import_funcionarios | manual | venda | catalogo
  pontos         Int?     @default(0)                              // fidelidade: saldo de pontos
  tags           ClienteTag[]
  pontoTransacoes PontoTransacao[]
  pctConsignado  Float?   @map("pct_consignado")
  faixaConsignado String? @map("faixa_consignado") // ok | alerta | limite | renda_pendente
  consignadoMesRef String? @map("consignado_mes_ref") // YYYY-MM em que pct/faixa foram calculados
  contratosConsignados ContratoConsignado[]

  @@map("clientes")
  @@index([estagioCrm])
  @@index([faixaConsignado])
}

model PontoTransacao {
  id         Int      @id @default(autoincrement())
  clienteId  Int      @map("cliente_id")
  vendaId    Int?     @map("venda_id")                            // venda que gerou o ganho (quando aplicável)
  tipo       String                                               // ganho | resgate | ajuste
  pontos     Int                                                  // positivo (ganho/ajuste+) ou negativo (resgate)
  descricao  String?
  criadoEm   DateTime @default(now()) @map("criado_em")

  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("ponto_transacoes")
}

model Tag {
  id       Int          @id @default(autoincrement())
  nome     String       @unique
  cor      String?                                    // token de cor (ex.: "success", "warning") ou hex
  clientes ClienteTag[]

  @@map("tags")
}

model Campanha {
  id         Int      @id @default(autoincrement())
  nome       String
  canal      String   @default("whatsapp")            // por ora só whatsapp
  filtroJson String   @map("filtro_json")             // SegmentoFiltro serializado
  mensagem   String                                   // usa {nome} como placeholder
  templateNome  String?  @map("template_nome")   // template aprovado na Meta
  variaveisJson String?  @map("variaveis_json")  // array JSON de variáveis, com {nome} suportado
  status     String   @default("rascunho")            // rascunho | agendada | enviando | concluida
  totalAlvo  Int      @default(0) @map("total_alvo")
  totalEnviado Int    @default(0) @map("total_enviado")
  agendadaPara DateTime? @map("agendada_para")         // quando status=agendada, disparo automático via cron
  criadaEm   DateTime @default(now()) @map("criada_em")
  enviadaEm  DateTime? @map("enviada_em")

  envios     CampanhaEnvio[]

  @@map("campanhas")
  @@index([status])
}

model CampanhaEnvio {
  id         Int      @id @default(autoincrement())
  campanhaId Int      @map("campanha_id")
  clienteId  Int      @map("cliente_id")
  status     String                                   // enviado | falha | sem_telefone
  erro       String?
  mensagemId Int?     @map("mensagem_id")
  enviadoEm  DateTime @default(now()) @map("enviado_em")

  campanha   Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  mensagem   WhatsAppMensagem? @relation(fields: [mensagemId], references: [id], onDelete: SetNull)

  @@unique([campanhaId, clienteId])
  @@index([clienteId])
  @@map("campanha_envios")
}

model ClienteTag {
  clienteId Int @map("cliente_id")
  tagId     Int @map("tag_id")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clienteId, tagId])
  @@index([tagId])
  @@map("cliente_tags")
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  custoPadrao Float?  @map("custo_padrao")
  marca      String?
  categoria  String?
  ncm        String?
  imagem     String?
  fornecedorId Int?   @map("fornecedor_id")
  qtdEstoque Int?     @default(0) @map("qtd_estoque")
  valorVenda Float?   @default(0) @map("valor_venda")
  dataCompra DateTime? @map("data_compra")
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])

  @@unique([nome, fornecedorId])
  @@map("produtos")
}

model Venda {
  id                 Int       @id @default(autoincrement())
  uuid               String?   @unique @db.Uuid
  dataVenda          DateTime  @map("data_venda")
  vendedor           String?   // DEPRECATED: manter para compatibilidade, usar vendedorId
  vendedorId         Int?      @map("vendedor_id")
  clienteId          Int?      @map("cliente_id")

  // DEPRECATED: Campos mantidos para compatibilidade com vendas antigas
  produtoNome        String?   @map("produto_nome")
  custoProduto       Float?    @map("custo_produto")
  quantidade         Int?      @default(1)
  valorVenda         Float?

  // Novos campos para venda com múltiplos produtos
  valorFrete         Float?    @default(0) @map("valor_frete")
  custoEnvio         Float?    @default(0) @map("custo_envio")
  // true = entrega, false = retirada, null = venda anterior ao seletor (sem backfill).
  entrega            Boolean?  @map("entrega")
  parcelas           Int?
  valorParcela       Float?    @map("valor_parcela")
  taxaFinanceiraValor Float?   @map("taxa_financeira_valor")
  lucroLiquido       Float?    @map("lucro_liquido")
  antecipada         Int?      @default(0)
  excedeuLimite      Int?      @default(0) @map("excedeu_limite")
  temNota            Boolean   @default(false) @map("tem_nota")
  taxaNota           Float?    @default(5.97) @map("taxa_nota")
  descontoEmFolha    Boolean   @default(false) @map("desconto_em_folha")
  desconto           Float?    @default(0) @map("desconto")
  boleto             Boolean   @default(false) @map("boleto")
  // Forma de pagamento canônica. Os campos descontoEmFolha/boleto sao mantidos
  // sincronizados via codigo para compatibilidade com integracoes legadas.
  // Valores: "DESCONTO_FOLHA" | "BOLETO" | "PIX" | "DINHEIRO" | "CARTAO_CREDITO" | "CARTAO_DEBITO" | "TRANSFERENCIA" | "OUTRO"
  formaPagamento     String?   @map("forma_pagamento")
  status             String    @default("ativa") @map("status") // "ativa" | "cancelada" | "estornada"
  asaasPaymentId     String?   @map("asaas_payment_id")
  boletoUrl          String?   @map("boleto_url")
  assinaturaToken    String?   @unique @map("assinatura_token")
  termoEmailStatus      String?   @map("termo_email_status")
  termoEmailEnviadoEm   DateTime? @map("termo_email_enviado_em")
  termoEmailErro        String?   @map("termo_email_erro")

  // QK-F21-02: rastreabilidade do custo real capturado da Uber Direct (Get Delivery
  // Status) e protecao contra sobrescrita. uberDeliveryId e @unique para que o mesmo
  // frete nunca seja lancado como custo em duas vendas.
  uberDeliveryId     String?   @unique @map("uber_delivery_id")
  // Valores possiveis: "manual" | "uber_provisorio" | "uber_final". Nulo = nunca
  // passou por esta integracao (custo digitado a mao ou venda anterior a ela).
  custoEnvioFonte    String?   @map("custo_envio_fonte")

  // Relacionamentos
  cliente            Cliente?   @relation(fields: [clienteId], references: [id])
  vendedorUsuario    Usuario?   @relation("vendas_vendedor", fields: [vendedorId], references: [id])
  itens              ItemVenda[]
  parcelasVencimento ParcelaVencimento[]
  documentos         Documento[]
  assinatura         Assinatura?

  // A fila da Central Prudent filtra por forma de pagamento a cada carga da tela.
  // O indice existia no backfill de forma_pagamento e foi perdido na migration de
  // reconciliacao de drift (20260720201100).
  @@index([formaPagamento])
  @@map("vendas")
}

model Documento {
  id           Int      @id @default(autoincrement())
  vendaId      Int?     @map("venda_id")
  tipo         String   @map("tipo")       // comprovante_assinatura, nfe, contrato, etc.
  mimeType     String   @map("mime_type")  @default("application/pdf")
  conteudo     Bytes    @db.ByteA
  tamanhoBytes Int      @map("tamanho_bytes")
  criadoEm     DateTime @default(now())    @map("criado_em")

  venda        Venda?   @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@map("documentos")
  @@index([vendaId])
  @@index([tipo])
}

model ItemVenda {
  id           Int     @id @default(autoincrement())
  vendaId      Int     @map("venda_id")
  produtoNome  String  @map("produto_nome")
  custoProduto Float   @map("custo_produto")
  valorVenda   Float   @map("valor_venda")
  quantidade   Int     @default(1)
  subtotal     Float   // quantidade * valorVenda

  venda        Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@map("itens_venda")
  @@index([vendaId])
}

model ParcelaVencimento {
  id              Int      @id @default(autoincrement())
  vendaId         Int      @map("venda_id")
  numeroParcela   Int      @map("numero_parcela")  // 1, 2, 3...
  dataVencimento  DateTime @map("data_vencimento")
  valorParcela    Float    @map("valor_parcela")
  paga            Boolean  @default(false)
  dataPagamento   DateTime? @map("data_pagamento")
  antecipada      Boolean  @default(false)
  origemPagamento String?  @map("origem_pagamento") // asaas | prudent | manual
  // Lote enviado à Prudent que ainda não voltou (2026-09-17). Com lote em andamento a parcela
  // sai da fila mas não é antecipada nem paga; concluir o lote é que grava isso.
  antecipacaoLoteId Int?   @map("antecipacao_lote_id")
  asaasPaymentId  String?  @unique @map("asaas_payment_id") // cobrança do Asaas que quitou a parcela
  baixaPor        String?  @map("baixa_por") // usuário da baixa manual
  // Confirmação do RH (2026-09-30, Fase 3). `enviadaRhEm` é a primeira vez que a parcela saiu no
  // consolidado semanal. `confirmacaoRh` nulo = aguardando; "confirmada" | "recusada".
  // `confirmacaoOrigem`: "rh" (registrada pela BFX) | "legado" (parcela anterior à Fase 3).
  // Só parcela confirmada entra na fila da Prudent.
  enviadaRhEm       DateTime? @map("enviada_rh_em")
  confirmacaoRh     String?   @map("confirmacao_rh")
  confirmacaoOrigem String?   @map("confirmacao_origem")
  confirmacaoEm     DateTime? @map("confirmacao_em")
  confirmacaoPor    String?   @map("confirmacao_por")
  confirmacaoMotivo String?   @map("confirmacao_motivo")

  // Boleto da Prudent que cobra esta parcela antecipada (2026-09-30, Fase 4). Nasce na conclusão
  // do lote; Restrict: boleto não some com parcela ligada.
  boletoPrudentId   Int?      @map("boleto_prudent_id")

  // Fechamento mensal (2026-09-30, Fase 5). `fechamentoId` é a reserva: parcela reservada só é
  // cobrada/baixada pelo fechamento. `liquidadaEm` = a empresa pagou esta parcela no fechamento.
  fechamentoId      Int?      @map("fechamento_id")
  liquidadaEm       DateTime? @map("liquidada_em")

  venda            Venda             @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  antecipacaoLote  AnticipacaoBatch? @relation(fields: [antecipacaoLoteId], references: [id], onDelete: SetNull)
  boletoPrudent    BoletoPrudent?    @relation(fields: [boletoPrudentId], references: [id], onDelete: Restrict)
  fechamento       Fechamento?       @relation(fields: [fechamentoId], references: [id], onDelete: SetNull)
  linhasFechamento FechamentoLinha[]

  @@map("parcelas_vencimento")
  @@unique([vendaId, numeroParcela])
  @@index([vendaId])
  @@index([dataVencimento])
  @@index([antecipacaoLoteId])
  @@index([confirmacaoRh])
  @@index([boletoPrudentId])
  @@index([fechamentoId])
}

model Config {
  id                    Int     @id @default(autoincrement())
  modeloContrato        String? @map("modelo_contrato")       // Autorização de desconto em folha
  modeloReciboVenda     String? @map("modelo_recibo_venda")   // Recibo padrão de venda de mercadoria
  logoPath              String? @map("logo_path")
  openaiKey             String? @map("openai_key")
  geminiKey             String? @map("gemini_key")
  asaasApiKey           String? @map("asaas_api_key")         // API Key do Asaas (boletos)
  asaasEnv              String? @map("asaas_env")             // sandbox | production
  asaasWebhookToken     String? @map("asaas_webhook_token")   // token do header asaas-access-token (baixa de parcela)
  asaasWebhookUltimoAvisoEm DateTime? @map("asaas_webhook_ultimo_aviso_em") // último POST autenticado do Asaas
  evolutionApiUrl       String? @map("evolution_api_url")
  evolutionApiKey       String? @map("evolution_api_key")
  evolutionInstance     String? @map("evolution_instance")    // Nome da instância na Evolution API
  // WhatsApp provider: "evolution" (padrão, não-oficial) | "meta_cloud" (oficial, sem risco de ban)
  whatsappProvider          String?  @default("evolution") @map("whatsapp_provider")
  metaWhatsappToken         String?  @map("meta_whatsapp_token")
  metaWhatsappPhoneNumberId String?  @map("meta_whatsapp_phone_number_id")
  metaWhatsappBusinessId    String?  @map("meta_whatsapp_business_id")
  metaWhatsappApiVersion    String?  @default("v21.0") @map("meta_whatsapp_api_version")
  metaWebhookVerifyToken    String?  @map("meta_webhook_verify_token")
  metaAppSecret             String?  @map("meta_app_secret")  // valida X-Hub-Signature-256 do webhook
  whatsappFallbackEvolution Int?     @default(1) @map("whatsapp_fallback_evolution") // 1=usa Evolution se Meta falhar
  whatsappAutoEnabled      Int?    @default(1) @map("whatsapp_auto_enabled")       // 1=ativado, 0=desativado
  whatsappAutoRecibo       Int?    @default(1) @map("whatsapp_auto_recibo")        // Enviar recibo/assinatura ao finalizar venda
  whatsappAutoBoleto       Int?    @default(1) @map("whatsapp_auto_boleto")        // Enviar link boleto ao gerar
  whatsappAutoLembrete     Int?    @default(1) @map("whatsapp_auto_lembrete")      // Lembrete parcelas 2 dias antes
  whatsappAutoReativacao   Int?    @default(0) @map("whatsapp_auto_reativacao")    // Reativação clientes inativos
  whatsappAutoAniversario  Int?    @default(0) @map("whatsapp_auto_aniversario")   // Parabéns no aniversário
  whatsappAutoInadimplencia Int?   @default(0) @map("whatsapp_auto_inadimplencia") // Parcela vencida
  whatsappAutoNPS          Int?    @default(0) @map("whatsapp_auto_nps")           // Pesquisa satisfação
  whatsappAutoBoasVindas   Int?    @default(0) @map("whatsapp_auto_boas_vindas")   // Boas-vindas cliente novo
  whatsappAutoAgradecimento Int?   @default(0) @map("whatsapp_auto_agradecimento") // Agradecimento 1 dia após venda
  whatsappDiasInativo      Int?    @default(60) @map("whatsapp_dias_inativo")      // Dias sem compra para reativação
  whatsappPreAtendimento   Int?    @default(0) @map("whatsapp_pre_atendimento")    // 1=IA pré-atende quem manda msg no WhatsApp
  whatsappTakeoverMinutos  Int?    @default(60) @map("whatsapp_takeover_minutos")
  aiProvider               String? @map("ai_provider")                            // gemini | openai | litellm
  litellmUrl               String? @map("litellm_url")
  litellmKey               String? @map("litellm_key")
  litellmModel             String? @map("litellm_model")
  litellmEnableThinking    Boolean? @default(false) @map("litellm_enable_thinking")
  // Email / SMTP
  smtpHost                 String? @map("smtp_host")
  smtpPort                 Int?    @map("smtp_port")
  smtpUser                 String? @map("smtp_user")
  smtpPass                 String? @map("smtp_pass")
  smtpFrom                 String? @map("smtp_from")
  adminEmail               String? @map("admin_email")
  // Recebe os alertas de obrigação da Prudent (2026-09-30, Fase 4). Sem ele, só notificação.
  emailFinanceiro          String? @map("email_financeiro")
  // Uber Direct (cotação de frete): client_id/client_secret via OAuth client_credentials —
  // nunca um token estático (a Uber não tem refresh token; guardar o token expira em ~30
  // dias sem aviso). O sistema troca por access_token sob demanda (src/lib/uber-auth.ts) e
  // cacheia até vencer.
  uberClientId              String? @map("uber_client_id")
  uberClientSecret          String? @map("uber_client_secret")
  uberCustomerId            String? @map("uber_customer_id")      // usado no path do Direct
  uberOrganizationId        String? @map("uber_organization_id")  // header x-uber-organizationuuid (Receipts)
  uberPickupAddress         String? @map("uber_pickup_address")   // JSON do endereço de coleta (loja)
  uberEnabled               Int?    @default(0) @map("uber_enabled") // 1=ativado pela tela; default 0 = opt-in

  @@map("config")
}

model Usuario {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  password     String
  role         String?
  nomeExibicao String? @map("nome_exibicao")
  email        String?
  telefone     String?
  dataNascimento DateTime? @map("data_nascimento")
  endereco     String?
  cep          String?
  metaMensal   Float?  @default(50000.0) @map("meta_mensal")
  comissaoPct  Float?  @default(2.0) @map("comissao_pct")

  vendas       Venda[]        @relation("vendas_vendedor")
  pagamentos   Pagamento[]    @relation("pagamentos_vendedor")
  notificacoes Notificacao[]
  aiMensagens  AiMensagem[]
  auditLogs    AuditLog[]

  @@map("usuarios")
}

model Fornecedor {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  telefone  String?
  deletedAt DateTime? @map("deleted_at")
  produtos  Produto[]

  @@index([deletedAt])
  @@map("fornecedores")
}

model EmpresaParceira {
  id            Int     @id @default(autoincrement())
  nome          String  @unique
  responsavelRh String? @map("responsavel_rh")
  telefoneRh    String? @map("telefone_rh")
  emailRh       String? @map("email_rh")
  cnpj          String? @map("cnpj")
  emailsExtras  String? @map("emails_extras")
  /// Em cópia (Cc) de todo e-mail ao RH: termo, consolidado semanal e relatório mensal.
  emailCopia    String? @map("email_copia")
  diaRelatorioMensal Int? @map("dia_relatorio_mensal")
  /// Cliente Asaas da empresa (pelo CNPJ) — paga o Pix do fechamento (Fase 6). Não é o do colaborador.
  asaasCustomerId String? @map("asaas_customer_id")

  clientes      Cliente[]
  vinculos      EmpresaVinculo[] @relation("empresa_origem")
  vinculadaPor  EmpresaVinculo[] @relation("empresa_destino")
  relatoriosEnviados RelatorioEnvioLog[]
  emailsEnviados EmailEnvio[]
  contratosConsignados ContratoConsignado[]
  regras        RegraEmpresa[]
  fechamentos   Fechamento[]

  @@map("empresas_parceiras")
}

/// Regras por empresa conveniada e período (spec 2026-09-30 §3.1): corte, vencimento das
/// parcelas, dia do Pix do fechamento, repasse e a chave do fluxo novo de cobrança. Vigências de
/// uma empresa não se sobrepõem (validado no save). Sem regra vigente vale `REGRA_PADRAO`.
model RegraEmpresa {
  id                Int       @id @default(autoincrement())
  empresaParceiraId Int       @map("empresa_parceira_id")
  vigenteDe         DateTime  @map("vigente_de") // inclusivo, data pura em UTC
  vigenteAte        DateTime? @map("vigente_ate") // exclusivo; nulo = aberta
  diaCorte          Int       @default(20) @map("dia_corte")
  diaVencimento     Int       @default(10) @map("dia_vencimento")
  diaPix            Int       @default(15) @map("dia_pix")
  repassePct        Float?    @map("repasse_pct")
  repasseBase       String?   @map("repasse_base") // "venda"
  cobrancaViaBfx    Boolean   @default(false) @map("cobranca_via_bfx")
  observacao        String?
  criadaEm          DateTime  @default(now()) @map("criada_em")
  criadaPor         String?   @map("criada_por")

  empresaParceira EmpresaParceira @relation(fields: [empresaParceiraId], references: [id], onDelete: Cascade)

  @@index([empresaParceiraId, vigenteDe])
  @@map("regras_empresa")
}

model ContratoConsignado {
  id                               Int      @id @default(autoincrement())
  ifConcessoraCodigo               String   @map("if_concessora_codigo")
  contrato                         String
  ifConcessoraDescricao            String?  @map("if_concessora_descricao")
  cpf                              String   @default("")
  matricula                        String?
  nomeTrabalhador                  String   @map("nome_trabalhador")
  nomeEmpregador                   String?  @map("nome_empregador")
  numeroInscricaoEmpregador        String?  @map("numero_inscricao_empregador")
  numeroInscricaoEstabelecimento   String?  @map("numero_inscricao_estabelecimento")
  competenciaInicioDesconto        String   @map("competencia_inicio_desconto")
  competenciaFimDesconto           String   @map("competencia_fim_desconto")
  valorParcela                     Float    @map("valor_parcela")
  totalParcelas                    Int?     @map("total_parcelas")
  valorEmprestimo                  Float?   @map("valor_emprestimo")
  valorLiberado                    Float?   @map("valor_liberado")
  dataInicioContrato               String?  @map("data_inicio_contrato")
  dataFimContrato                  String?  @map("data_fim_contrato")
  dataAdmissao                     String?  @map("data_admissao")
  categoriaTrabalhador             String?  @map("categoria_trabalhador")
  competenciaArquivo               String?  @map("competencia_arquivo")
  clienteId                        Int      @map("cliente_id")
  empresaParceiraId                Int?     @map("empresa_parceira_id")
  criadoEm                         DateTime @default(now()) @map("criado_em")
  atualizadoEm                     DateTime @updatedAt @map("atualizado_em")

  cliente         Cliente          @relation(fields: [clienteId], references: [id])
  empresaParceira EmpresaParceira? @relation(fields: [empresaParceiraId], references: [id])

  @@unique([ifConcessoraCodigo, contrato])
  @@index([clienteId])
  @@index([cpf])
  @@index([empresaParceiraId])
  @@map("contratos_consignados")
}

model EmpresaVinculo {
  id          Int @id @default(autoincrement())
  empresaId   Int @map("empresa_id")
  vinculadaId Int @map("vinculada_id")

  empresa   EmpresaParceira @relation("empresa_origem",  fields: [empresaId],   references: [id], onDelete: Cascade)
  vinculada EmpresaParceira @relation("empresa_destino", fields: [vinculadaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, vinculadaId])
  @@map("empresas_vinculos")
}

model Pagamento {
  id           Int      @id @default(autoincrement())
  dataPagamento DateTime @map("data_pagamento")
  vendedor     String?   // DEPRECATED: manter para compatibilidade, usar vendedorId
  vendedorId   Int?      @map("vendedor_id")
  valor        Float?
  obs          String?

  vendedorUsuario Usuario? @relation("pagamentos_vendedor", fields: [vendedorId], references: [id])

  @@map("pagamentos")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  dataHora  DateTime @map("data_hora")
  usuario   String?  // DEPRECATED: manter para compatibilidade, usar usuarioId
  usuarioId Int?     @map("usuario_id")
  acao      String?
  detalhes  String?

  usuarioRef Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("audit_logs")
}

model Despesa {
  id         Int      @id @default(autoincrement())
  dataDespesa DateTime @map("data_despesa")
  descricao  String?
  categoria  String?
  valor      Float?
  tipo       String?

  @@map("despesas")
}

model Aviso {
  id          Int      @id @default(autoincrement())
  dataCriacao DateTime @default(now()) @map("data_criacao")
  mensagem    String?
  ativo       Int?     @default(1)

  @@map("avisos")
}

model WhatsAppEnvioLog {
  id          Int      @id @default(autoincrement())
  clienteId   Int      @map("cliente_id")
  tipo        String   // reativacao, aniversario, inadimplencia, nps, boasvindas, agradecimento
  referencia  Int?     // vendaId quando aplicável
  provider    String?  // evolution | meta_cloud (provider usado no envio)
  dataEnvio   DateTime @default(now()) @map("data_envio")

  @@index([clienteId, tipo])
  @@index([tipo, referencia])
  @@map("whatsapp_envio_log")
}

model RelatorioEnvioLog {
  id            Int      @id @default(autoincrement())
  empresaId     Int      @map("empresa_id")      // empresa canônica do grupo econômico
  periodo       String                            // "2026-06" (YYYY-MM)
  tipo          String   @default("mensal")       // mensal | semanal
  destinatarios String?                            // e-mails separados por vírgula
  status        String                            // enviado | erro | sem_vendas | sem_email
  erro          String?
  totalVendas   Int      @default(0) @map("total_vendas")
  valorTotal    Float    @default(0) @map("valor_total")
  pdfKey        String?  @map("pdf_key")           // chave no MinIO (download/reenvio)
  xlsxKey       String?  @map("xlsx_key")
  enviadoEm     DateTime @default(now()) @map("enviado_em")

  empresa EmpresaParceira @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, periodo, tipo])
  @@index([periodo])
  @@map("relatorio_envio_log")
}

model AiMensagem {
  id             Int      @id @default(autoincrement())
  sessaoId       String   @map("sessao_id")
  role           String
  content        String
  contextResumo  String?  @map("context_resumo")
  promptOriginal String?  @map("prompt_original")
  actions        Json?
  status         String   @default("done")
  links          Json?
  // Provedor que gerou ESTA resposta (gemini | openai | litellm). Persistido no
  // momento da escrita porque `config.aiProvider` muda com o tempo: ler o
  // provedor atual na renderizacao rotularia o historico inteiro com a
  // configuracao de hoje. Nulo nas linhas anteriores a esta coluna — e nulo
  // significa "desconhecido", nunca "gemini" (a pilula some).
  provider       String?
  usuario        String?  // DEPRECATED: manter para compatibilidade, usar usuarioId
  usuarioId      Int?     @map("usuario_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  usuarioRef     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([sessaoId, criadoEm])
  @@index([usuarioId])
  @@map("ai_mensagens")
}

model Assinatura {
  id               Int       @id @default(autoincrement())
  vendaId          Int       @unique @map("venda_id")
  assinaturaStatus String?   @map("assinatura_status") // pendente | processando | assinado | expirado
  assinaturaEm     DateTime? @map("assinatura_em")
  venda            Venda     @relation(fields: [vendaId], references: [id])

  @@map("assinaturas")
}

model Notificacao {
  id        Int      @id @default(autoincrement())
  mensagem  String
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")
  link      String?
  usuarioId Int?     @map("usuario_id")

  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

model VozDublador {
  id          Int      @id @default(autoincrement())
  nome        String                                    // Ex: "Guilherme Briggs"
  descricao   String?                                   // Ex: "Voz grave, dramática"
  idioma      String   @default("pt-BR")
  genero      String?                                   // "masculino" | "feminino"
  estilo      String?                                   // "narrador", "personagem", "comercial"
  minioUrl    String   @map("minio_url")               // URL pública do arquivo no MinIO
  minioKey    String   @map("minio_key")               // Chave interna no bucket (para download)
  ativo       Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("vozes_dubladores")
}

model AnticipacaoBatch {
  id                Int       @id @default(autoincrement())
  criadaEm          DateTime  @default(now()) @map("criada_em")
  vendaIds          String    @map("venda_ids")  // JSON: "[1,2,3]"
  valorTotal        Float     @map("valor_total")
  quantidadeVendas  Int       @map("quantidade_vendas")
  periodoDescricao  String?   @map("periodo_descricao") // ex: "mar/2025 - abr/2025"
  periodoInicio     DateTime? @map("periodo_inicio")
  periodoFim        DateTime? @map("periodo_fim")
  // Ciclo do lote (2026-09-17): nasce `em_andamento` no envio, vira `concluido` quando o André
  // confirma o retorno da Prudent, ou `cancelado` quando ela recusa.
  status            String    @default("em_andamento")
  // envio (gerou o Excel) | registro (antecipação feita antes de o sistema saber) | conciliacao
  origem            String    @default("envio")
  concluidaEm       DateTime? @map("concluida_em")
  concluidaPor      String?   @map("concluida_por")
  observacao        String?
  // Valores do lote (2026-09-30, Fase 3). Sem FK para a empresa: lote antigo não tem.
  empresaParceiraId      Int?      @map("empresa_parceira_id")
  taxaMensal             Float?    @map("taxa_mensal")
  valorLiquidoSolicitado Float?    @map("valor_liquido_solicitado")
  valorAprovado          Float?    @map("valor_aprovado")
  valorDepositado        Float?    @map("valor_depositado")
  dataDepositoPrevista   DateTime? @map("data_deposito_prevista")
  dataDeposito           DateTime? @map("data_deposito")
  comprovanteKey         String?   @map("comprovante_key")

  parcelas          ParcelaVencimento[]
  boletos           BoletoPrudent[]

  @@map("antecipacao_batches")
}

/// Arquivo privado do financeiro (PDF do boleto Prudent, comprovante de pagamento), em bytes no
/// banco como `Documento`: o bucket MinIO só serve chaves públicas. Servido por
/// `/api/arquivos/[id]` só para admin.
model ArquivoFinanceiro {
  id          Int      @id @default(autoincrement())
  nome        String
  contentType String   @map("content_type")
  tamanho     Int
  sha256      String   @map("sha256")
  conteudo    Bytes
  criadoEm    DateTime @default(now()) @map("criado_em")
  criadoPor   String?  @map("criado_por")

  boletosPdf      BoletoPrudent[]    @relation("boleto_pdf")
  pagamentos      BoletoPagamento[]  @relation("pagamento_comprovante")
  fechamentosXlsx FechamentoVersao[] @relation("fechamento_xlsx")
  fechamentosPdf  FechamentoVersao[] @relation("fechamento_pdf")
  recebimentosComprovante RecebimentoFechamento[] @relation("recebimento_comprovante")

  @@index([sha256])
  @@map("arquivos_financeiros")
}

/// Boleto da Prudent por lote × vencimento (spec 2026-09-30 §3.4). Nasce em `concluirLote`
/// aguardando o documento. Um boleto vivo por (lote, vencimento): índice parcial na migração
/// `20260930140000_boletos_prudent`, fora do schema (o Prisma não representa índice parcial).
model BoletoPrudent {
  id                       Int       @id @default(autoincrement())
  loteId                   Int       @map("lote_id")
  empresaParceiraId        Int?      @map("empresa_parceira_id")
  vencimento               DateTime
  valorEsperado            Float     @map("valor_esperado")
  valorDocumento           Float?    @map("valor_documento")
  vencimentoDocumento      DateTime? @map("vencimento_documento")
  linhaDigitavel           String?   @unique @map("linha_digitavel")
  pdfArquivoId             Int?      @map("pdf_arquivo_id")
  // "empresa" (a Prudent cobra a empresa) | "bfx" (a BFX paga)
  direcionamento           String    @default("empresa")
  // aguardando_documento | a_pagar | pago_parcial | pago | substituido | cancelado
  status                   String    @default("aguardando_documento")
  divergenciaJustificativa String?   @map("divergencia_justificativa")
  substituiId              Int?      @unique @map("substitui_id")
  criadoEm                 DateTime  @default(now()) @map("criado_em")
  atualizadoEm             DateTime  @updatedAt @map("atualizado_em")

  lote        AnticipacaoBatch   @relation(fields: [loteId], references: [id], onDelete: Restrict)
  pdf         ArquivoFinanceiro? @relation("boleto_pdf", fields: [pdfArquivoId], references: [id], onDelete: SetNull)
  substitui   BoletoPrudent?     @relation("substituicao", fields: [substituiId], references: [id], onDelete: Restrict)
  substituto  BoletoPrudent?     @relation("substituicao")
  parcelas    ParcelaVencimento[]
  pagamentos  BoletoPagamento[]

  @@index([vencimento])
  @@index([loteId])
  @@map("boletos_prudent")
}

/// Pagamento de um boleto Prudent pela BFX (spec §3.5). Estorno marca `estornadoEm`; nada some.
/// `comprovanteHash` único impede usar o mesmo comprovante duas vezes.
model BoletoPagamento {
  id                   Int       @id @default(autoincrement())
  boletoId             Int       @map("boleto_id")
  dataPagamento        DateTime  @map("data_pagamento")
  valorPrincipal       Float     @map("valor_principal")
  valorEncargos        Float     @default(0) @map("valor_encargos")
  comprovanteArquivoId Int?      @map("comprovante_arquivo_id")
  comprovanteHash      String?   @unique @map("comprovante_hash")
  autenticacao         String?
  registradoPor        String?   @map("registrado_por")
  criadoEm             DateTime  @default(now()) @map("criado_em")
  estornadoEm          DateTime? @map("estornado_em")
  estornadoPor         String?   @map("estornado_por")

  boleto      BoletoPrudent      @relation(fields: [boletoId], references: [id], onDelete: Restrict)
  comprovante ArquivoFinanceiro? @relation("pagamento_comprovante", fields: [comprovanteArquivoId], references: [id], onDelete: SetNull)

  @@index([boletoId])
  @@map("boletos_prudent_pagamentos")
}

/// Fechamento mensal de uma empresa numa competência (mês de vencimento) — spec 2026-09-30 §3.6.
/// em_preparacao → conferido → enviado (Fase 5) → pago_parcial | pago (Fase 6). As parcelas
/// reservadas apontam para cá por `ParcelaVencimento.fechamentoId`. `desatualizado` = alguma
/// reserva saiu por edição/exclusão de venda depois da geração.
model Fechamento {
  id                Int      @id @default(autoincrement())
  empresaParceiraId Int      @map("empresa_parceira_id")
  competencia       String // "AAAA-MM"
  status            String   @default("em_preparacao")
  responsavel       String?
  versaoAtual       Int      @default(0) @map("versao_atual")
  desatualizado     Boolean  @default(false)
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  empresaParceira EmpresaParceira     @relation(fields: [empresaParceiraId], references: [id], onDelete: Restrict)
  versoes         FechamentoVersao[]
  ajustes         FechamentoAjuste[]
  parcelas        ParcelaVencimento[]
  cobrancas       CobrancaFechamento[]
  recebimentos    RecebimentoFechamento[]

  @@unique([empresaParceiraId, competencia])
  @@map("fechamentos")
}

/// Versão conferida do fechamento: foto das linhas, totais, ajustes e os arquivos gerados.
model FechamentoVersao {
  id            Int       @id @default(autoincrement())
  fechamentoId  Int       @map("fechamento_id")
  numero        Int
  totalBruto    Float     @map("total_bruto")
  totalAjustes  Float     @map("total_ajustes")
  totalFinal    Float     @map("total_final")
  ajustesJson   String    @map("ajustes_json")
  xlsxArquivoId Int?      @map("xlsx_arquivo_id")
  pdfArquivoId  Int?      @map("pdf_arquivo_id")
  criadaEm      DateTime  @default(now()) @map("criada_em")
  criadaPor     String?   @map("criada_por")
  enviadaEm     DateTime? @map("enviada_em")
  enviadaPor    String?   @map("enviada_por")

  fechamento Fechamento         @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  xlsx       ArquivoFinanceiro? @relation("fechamento_xlsx", fields: [xlsxArquivoId], references: [id], onDelete: SetNull)
  pdf        ArquivoFinanceiro? @relation("fechamento_pdf", fields: [pdfArquivoId], references: [id], onDelete: SetNull)
  linhas     FechamentoLinha[]
  cobrancas  CobrancaFechamento[]

  @@unique([fechamentoId, numero])
  @@map("fechamento_versoes")
}

/// Linha (foto) de uma versão. `parcelaId` SetNull: a edição de venda apaga e recria parcelas.
model FechamentoLinha {
  id              Int      @id @default(autoincrement())
  versaoId        Int      @map("versao_id")
  parcelaId       Int?     @map("parcela_id")
  vendaId         Int      @map("venda_id")
  numeroParcela   Int      @map("numero_parcela")
  totalParcelas   Int      @map("total_parcelas")
  clienteNome     String   @map("cliente_nome")
  matricula       String?
  valor           Float
  vencimento      DateTime
  loteId          Int?     @map("lote_id")
  antecipada      Boolean
  boletoPrudentId Int?     @map("boleto_prudent_id")

  versao  FechamentoVersao   @relation(fields: [versaoId], references: [id], onDelete: Cascade)
  parcela ParcelaVencimento? @relation(fields: [parcelaId], references: [id], onDelete: SetNull)

  @@index([versaoId])
  @@index([parcelaId])
  @@map("fechamento_linhas")
}

/// Ajuste manual (±) do fechamento, com justificativa. Remoção é lógica (`removidoEm`).
model FechamentoAjuste {
  id            Int       @id @default(autoincrement())
  fechamentoId  Int       @map("fechamento_id")
  valor         Float
  justificativa String
  criadoPor     String?   @map("criado_por")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  removidoEm    DateTime? @map("removido_em")

  fechamento Fechamento @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)

  @@index([fechamentoId])
  @@map("fechamento_ajustes")
}

/// Cobrança Pix do Asaas de uma versão enviada do fechamento (Fase 6, spec §3.6). Uma cobrança
/// `ativa` por fechamento: índice único parcial na migração `20260930160000_cobranca_recebimento_fechamento`,
/// fora do schema. Ao enviar a versão N+1, a ativa anterior é cancelada no Asaas (se não foi paga).
/// `externalReference` = "FEC-{empresaId}-{AAAA-MM}-v{N}".
model CobrancaFechamento {
  id                Int       @id @default(autoincrement())
  fechamentoId      Int       @map("fechamento_id")
  versaoId          Int       @map("versao_id")
  asaasPaymentId    String    @unique @map("asaas_payment_id")
  externalReference String    @map("external_reference")
  valor             Float
  vencimento        DateTime
  // ativa | cancelada | paga
  status            String    @default("ativa")
  pixCopiaECola     String?   @map("pix_copia_e_cola")
  qrCodePng         Bytes?    @map("qr_code_png")
  criadaEm          DateTime  @default(now()) @map("criada_em")
  canceladaEm       DateTime? @map("cancelada_em")

  fechamento   Fechamento              @relation(fields: [fechamentoId], references: [id], onDelete: Restrict)
  versao       FechamentoVersao        @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  recebimentos RecebimentoFechamento[]

  @@index([fechamentoId])
  @@index([versaoId])
  @@map("cobrancas_fechamento")
}

/// Dinheiro que entrou para um fechamento (o recebimento é do fechamento, não da versão). Do Asaas
/// (webhook; único por `asaasPaymentId`) ou manual em dois passos (pendente → confirmado). Só
/// `confirmado` conta. Estorno marca `estornado`; nada some.
model RecebimentoFechamento {
  id                   Int       @id @default(autoincrement())
  fechamentoId         Int       @map("fechamento_id")
  cobrancaId           Int?      @map("cobranca_id")
  // asaas | manual
  origem               String
  valor                Float
  dataRecebimento      DateTime  @map("data_recebimento")
  asaasPaymentId       String?   @unique @map("asaas_payment_id")
  endToEndId           String?   @map("end_to_end_id")
  comprovanteArquivoId Int?      @map("comprovante_arquivo_id")
  // pendente | confirmado | estornado
  status               String
  registradoPor        String?   @map("registrado_por")
  confirmadoPor        String?   @map("confirmado_por")
  confirmadoEm         DateTime? @map("confirmado_em")
  estornadoEm          DateTime? @map("estornado_em")
  criadoEm             DateTime  @default(now()) @map("criado_em")

  fechamento  Fechamento          @relation(fields: [fechamentoId], references: [id], onDelete: Restrict)
  cobranca    CobrancaFechamento? @relation(fields: [cobrancaId], references: [id], onDelete: Restrict)
  comprovante ArquivoFinanceiro?  @relation("recebimento_comprovante", fields: [comprovanteArquivoId], references: [id], onDelete: SetNull)

  @@index([fechamentoId])
  @@index([cobrancaId])
  @@map("recebimentos_fechamento")
}

/// Registro unificado de mensagens WhatsApp (entrada e saída).
/// Fonte de verdade do histórico por cliente, do status de entrega e da
/// janela de 24h. Não substitui WhatsAppEnvioLog, que segue sendo o guarda
/// de deduplicação dos crons.
model WhatsAppMensagem {
  id           Int      @id @default(autoincrement())
  clienteId    Int?     @map("cliente_id")
  telefone     String
  direcao      String                                  // in | out
  waMessageId  String?  @unique @map("wa_message_id")  // id da Meta (wamid.*)
  origem       String                                  // cron | campanha | venda | boleto | relatorio | pre_atendimento | manual
  templateNome String?  @map("template_nome")          // null quando texto livre
  corpo        String
  status       String   @default("pendente")           // pendente | enviado | entregue | lido | falhou
  erroCodigo   Int?     @map("erro_codigo")
  erroMsg      String?  @map("erro_msg")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  envios       CampanhaEnvio[]

  @@index([clienteId, criadoEm])
  @@index([status, criadoEm])
  @@index([telefone, direcao, criadoEm])
  @@map("whatsapp_mensagens")
}

/// Histórico de todo e-mail enviado pelo sistema (termo, consolidado semanal, relatório mensal, aviso
/// de venda), com o corpo e os anexos como foram enviados. Anexo fica no banco, não no MinIO: o bucket
/// é de leitura pública e o termo tem CPF e assinatura.
model EmailEnvio {
  id         Int      @id @default(autoincrement())
  tipo       String                                  // termo | semanal | mensal | venda
  origem     String   @default("automatico")         // automatico | manual
  empresaId  Int?     @map("empresa_id")
  vendaId    Int?     @map("venda_id")
  remetente  String
  para       String                                  // e-mails separados por ", "
  cc         String?
  assunto    String
  corpoHtml  String   @map("corpo_html")
  status     String                                  // enviado | falhou
  erro       String?
  enviadoEm  DateTime @default(now()) @map("enviado_em")

  empresa EmpresaParceira? @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  anexos  EmailEnvioAnexo[]

  @@index([empresaId, enviadoEm])
  @@index([enviadoEm])
  @@map("email_envios")
}

model EmailEnvioAnexo {
  id          Int    @id @default(autoincrement())
  envioId     Int    @map("envio_id")
  nome        String
  contentType String @map("content_type")
  tamanho     Int
  conteudo    Bytes

  envio EmailEnvio @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@index([envioId])
  @@map("email_envio_anexos")
}
