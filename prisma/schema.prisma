generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id             Int       @id @default(autoincrement())
  nome           String    @unique
  renda          Float?
  empresa        String?
  matricula      String?
  telefone       String?
  cpf            String?
  cnpj           String?
  tipo           String?
  dataNascimento DateTime? @map("data_nascimento")
  cep            String?
  endereco       String?
  email          String?
  asaasCustomerId String?   @map("asaas_customer_id")
  atendimentoHumanoAt DateTime? @map("atendimento_humano_at")
  empresaParceiraId Int?    @map("empresa_parceira_id")
  empresaParceira   EmpresaParceira? @relation(fields: [empresaParceiraId], references: [id])
  vendas         Venda[]

  @@map("clientes")
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  custoPadrao Float?  @map("custo_padrao")
  marca      String?
  categoria  String?
  ncm        String?
  imagem     String?
  fornecedorId Int?   @map("fornecedor_id")
  qtdEstoque Int?     @default(0) @map("qtd_estoque")
  valorVenda Float?   @default(0) @map("valor_venda")
  dataCompra DateTime? @map("data_compra")
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])

  @@unique([nome, fornecedorId])
  @@map("produtos")
}

model Venda {
  id                 Int       @id @default(autoincrement())
  uuid               String?   @unique @db.Uuid
  dataVenda          DateTime  @map("data_venda")
  vendedor           String?
  clienteId          Int?      @map("cliente_id")

  // DEPRECATED: Campos mantidos para compatibilidade com vendas antigas
  produtoNome        String?   @map("produto_nome")
  custoProduto       Float?    @map("custo_produto")
  quantidade         Int?      @default(1)
  valorVenda         Float?

  // Novos campos para venda com múltiplos produtos
  valorFrete         Float?    @default(0) @map("valor_frete")
  custoEnvio         Float?    @default(0) @map("custo_envio")
  parcelas           Int?
  valorParcela       Float?    @map("valor_parcela")
  taxaFinanceiraValor Float?   @map("taxa_financeira_valor")
  lucroLiquido       Float?    @map("lucro_liquido")
  antecipada         Int?      @default(0)
  excedeuLimite      Int?      @default(0) @map("excedeu_limite")
  temNota            Boolean   @default(false) @map("tem_nota")
  taxaNota           Float?    @default(5.97) @map("taxa_nota")
  descontoEmFolha    Boolean   @default(false) @map("desconto_em_folha")
  desconto           Float?    @default(0) @map("desconto")
  boleto             Boolean   @default(false) @map("boleto")
  status             String    @default("ativa") @map("status") // "ativa" | "cancelada" | "estornada"
  asaasPaymentId     String?   @map("asaas_payment_id")
  boletoUrl          String?   @map("boleto_url")
  assinaturaToken    String?   @unique @map("assinatura_token")


  // Relacionamentos
  cliente            Cliente?   @relation(fields: [clienteId], references: [id])
  itens              ItemVenda[]
  parcelasVencimento ParcelaVencimento[]
  documentos         Documento[]
  assinatura         Assinatura?

  @@map("vendas")
}

model Documento {
  id           Int      @id @default(autoincrement())
  vendaId      Int?     @map("venda_id")
  tipo         String   @map("tipo")       // comprovante_assinatura, nfe, contrato, etc.
  mimeType     String   @map("mime_type")  @default("application/pdf")
  conteudo     Bytes    @db.ByteA
  tamanhoBytes Int      @map("tamanho_bytes")
  criadoEm     DateTime @default(now())    @map("criado_em")

  venda        Venda?   @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@map("documentos")
  @@index([vendaId])
  @@index([tipo])
}

model ItemVenda {
  id           Int     @id @default(autoincrement())
  vendaId      Int     @map("venda_id")
  produtoNome  String  @map("produto_nome")
  custoProduto Float   @map("custo_produto")
  valorVenda   Float   @map("valor_venda")
  quantidade   Int     @default(1)
  subtotal     Float   // quantidade * valorVenda

  venda        Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@map("itens_venda")
  @@index([vendaId])
}

model ParcelaVencimento {
  id              Int      @id @default(autoincrement())
  vendaId         Int      @map("venda_id")
  numeroParcela   Int      @map("numero_parcela")  // 1, 2, 3...
  dataVencimento  DateTime @map("data_vencimento")
  valorParcela    Float    @map("valor_parcela")
  paga            Boolean  @default(false)
  dataPagamento   DateTime? @map("data_pagamento")
  antecipada      Boolean  @default(false)

  venda           Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@map("parcelas_vencimento")
  @@index([vendaId])
  @@index([dataVencimento])
}

model Config {
  id                    Int     @id @default(autoincrement())
  modeloContrato        String? @map("modelo_contrato")       // Autorização de desconto em folha
  modeloReciboVenda     String? @map("modelo_recibo_venda")   // Recibo padrão de venda de mercadoria
  logoPath              String? @map("logo_path")
  openaiKey             String? @map("openai_key")
  geminiKey             String? @map("gemini_key")
  asaasApiKey           String? @map("asaas_api_key")         // API Key do Asaas (boletos)
  asaasEnv              String? @map("asaas_env")             // sandbox | production
  evolutionApiUrl       String? @map("evolution_api_url")
  evolutionApiKey       String? @map("evolution_api_key")
  evolutionInstance     String? @map("evolution_instance")    // Nome da instância na Evolution API
  whatsappAutoEnabled      Int?    @default(1) @map("whatsapp_auto_enabled")       // 1=ativado, 0=desativado
  whatsappAutoRecibo       Int?    @default(1) @map("whatsapp_auto_recibo")        // Enviar recibo/assinatura ao finalizar venda
  whatsappAutoBoleto       Int?    @default(1) @map("whatsapp_auto_boleto")        // Enviar link boleto ao gerar
  whatsappAutoLembrete     Int?    @default(1) @map("whatsapp_auto_lembrete")      // Lembrete parcelas 2 dias antes
  whatsappAutoReativacao   Int?    @default(0) @map("whatsapp_auto_reativacao")    // Reativação clientes inativos
  whatsappAutoAniversario  Int?    @default(0) @map("whatsapp_auto_aniversario")   // Parabéns no aniversário
  whatsappAutoInadimplencia Int?   @default(0) @map("whatsapp_auto_inadimplencia") // Parcela vencida
  whatsappAutoNPS          Int?    @default(0) @map("whatsapp_auto_nps")           // Pesquisa satisfação
  whatsappAutoBoasVindas   Int?    @default(0) @map("whatsapp_auto_boas_vindas")   // Boas-vindas cliente novo
  whatsappAutoAgradecimento Int?   @default(0) @map("whatsapp_auto_agradecimento") // Agradecimento 1 dia após venda
  whatsappDiasInativo      Int?    @default(60) @map("whatsapp_dias_inativo")      // Dias sem compra para reativação
  whatsappPreAtendimento   Int?    @default(0) @map("whatsapp_pre_atendimento")    // 1=IA pré-atende quem manda msg no WhatsApp
  whatsappTakeoverMinutos  Int?    @default(60) @map("whatsapp_takeover_minutos")
  aiProvider               String? @map("ai_provider")                            // gemini | openai | litellm
  litellmUrl               String? @map("litellm_url")
  litellmKey               String? @map("litellm_key")
  litellmModel             String? @map("litellm_model")
  litellmEnableThinking    Boolean? @default(false) @map("litellm_enable_thinking")
  // Email / SMTP
  smtpHost                 String? @map("smtp_host")
  smtpPort                 Int?    @map("smtp_port")
  smtpUser                 String? @map("smtp_user")
  smtpPass                 String? @map("smtp_pass")
  smtpFrom                 String? @map("smtp_from")
  adminEmail               String? @map("admin_email")

  @@map("config")
}

model Usuario {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  password     String
  role         String?
  nomeExibicao String? @map("nome_exibicao")
  email        String?
  telefone     String?
  dataNascimento DateTime? @map("data_nascimento")
  endereco     String?
  cep          String?
  metaMensal   Float?  @default(50000.0) @map("meta_mensal")
  comissaoPct  Float?  @default(2.0) @map("comissao_pct")

  @@map("usuarios")
}

model Fornecedor {
  id       Int     @id @default(autoincrement())
  nome     String  @unique
  telefone String?
  produtos Produto[]

  @@map("fornecedores")
}

model EmpresaParceira {
  id            Int     @id @default(autoincrement())
  nome          String  @unique
  responsavelRh String? @map("responsavel_rh")
  telefoneRh    String? @map("telefone_rh")
  emailRh       String? @map("email_rh")
  cnpj          String? @map("cnpj")
  emailsExtras  String? @map("emails_extras")

  clientes      Cliente[]
  vinculos      EmpresaVinculo[] @relation("empresa_origem")
  vinculadaPor  EmpresaVinculo[] @relation("empresa_destino")

  @@map("empresas_parceiras")
}

model EmpresaVinculo {
  id          Int @id @default(autoincrement())
  empresaId   Int @map("empresa_id")
  vinculadaId Int @map("vinculada_id")

  empresa   EmpresaParceira @relation("empresa_origem",  fields: [empresaId],   references: [id], onDelete: Cascade)
  vinculada EmpresaParceira @relation("empresa_destino", fields: [vinculadaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, vinculadaId])
  @@map("empresas_vinculos")
}

model Pagamento {
  id           Int      @id @default(autoincrement())
  dataPagamento DateTime @map("data_pagamento")
  vendedor     String?
  valor        Float?
  obs          String?

  @@map("pagamentos")
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  dataHora DateTime @map("data_hora")
  usuario  String?
  acao     String?
  detalhes String?

  @@map("audit_logs")
}

model Despesa {
  id         Int      @id @default(autoincrement())
  dataDespesa DateTime @map("data_despesa")
  descricao  String?
  categoria  String?
  valor      Float?
  tipo       String?

  @@map("despesas")
}

model Aviso {
  id          Int      @id @default(autoincrement())
  dataCriacao DateTime @default(now()) @map("data_criacao")
  mensagem    String?
  ativo       Int?     @default(1)

  @@map("avisos")
}

model WhatsAppEnvioLog {
  id          Int      @id @default(autoincrement())
  clienteId   Int      @map("cliente_id")
  tipo        String   // reativacao, aniversario, inadimplencia, nps, boasvindas, agradecimento
  referencia  Int?     // vendaId quando aplicável
  dataEnvio   DateTime @default(now()) @map("data_envio")

  @@index([clienteId, tipo])
  @@index([tipo, referencia])
  @@map("whatsapp_envio_log")
}

model AiMensagem {
  id             Int      @id @default(autoincrement())
  sessaoId       String   @map("sessao_id")
  role           String
  content        String
  contextResumo  String?  @map("context_resumo")
  promptOriginal String?  @map("prompt_original")
  actions        Json?
  status         String   @default("done")
  links          Json?
  usuario        String?
  criadoEm       DateTime @default(now()) @map("criado_em")

  @@index([sessaoId, criadoEm])
  @@map("ai_mensagens")
}

model Assinatura {
  id               Int       @id @default(autoincrement())
  vendaId          Int       @unique @map("venda_id")
  assinaturaStatus String?   @map("assinatura_status") // pendente | assinado | expirado
  assinaturaEm     DateTime? @map("assinatura_em")
  venda            Venda     @relation(fields: [vendaId], references: [id])

  @@map("assinaturas")
}

model Notificacao {
  id        Int      @id @default(autoincrement())
  mensagem  String
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now()) @map("criado_em")
  link      String?

  @@map("notificacoes")
}

model VozDublador {
  id          Int      @id @default(autoincrement())
  nome        String                                    // Ex: "Guilherme Briggs"
  descricao   String?                                   // Ex: "Voz grave, dramática"
  idioma      String   @default("pt-BR")
  genero      String?                                   // "masculino" | "feminino"
  estilo      String?                                   // "narrador", "personagem", "comercial"
  minioUrl    String   @map("minio_url")               // URL pública do arquivo no MinIO
  minioKey    String   @map("minio_key")               // Chave interna no bucket (para download)
  ativo       Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("vozes_dubladores")
}

model AnticipacaoBatch {
  id                Int       @id @default(autoincrement())
  criadaEm          DateTime  @default(now()) @map("criada_em")
  vendaIds          String    @map("venda_ids")  // JSON: "[1,2,3]"
  valorTotal        Float     @map("valor_total")
  quantidadeVendas  Int       @map("quantidade_vendas")
  periodoDescricao  String?   @map("periodo_descricao") // ex: "mar/2025 - abr/2025"
  periodoInicio     DateTime? @map("periodo_inicio")
  periodoFim        DateTime? @map("periodo_fim")

  @@map("antecipacao_batches")
}
